{
  "name": "astro-build",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run index-search",
    "index-search": "pagefind --site dist --output-path dist/pagefind",
    "preview": "astro preview",
    "astro": "astro",
    "push:content": "node scripts/apply-seo.mjs && node scripts/remove-categories.mjs",
    "push:content:dry": "node scripts/apply-seo.mjs --dry-run && node scripts/remove-categories.mjs --dry-run",
    "push:studio": "cd studio && npx sanity deploy"
  },
  "dependencies": {
    "@portabletext/to-html": "^6.0.0",
    "@sanity/client": "^8.6.2",
    "@sanity/image-url": "^2.1.1",
    "astro": "^7.3.3",
    "pagefind": "^1.5.2"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}
