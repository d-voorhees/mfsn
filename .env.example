# Safe to expose to the browser (Astro requires the PUBLIC_ prefix for that).
# These only identify which Sanity dataset to read from a public, published dataset;
# they grant no write access and are not secret.
PUBLIC_SANITY_PROJECT_ID=js71ru0h
PUBLIC_SANITY_DATASET=production

# Sanity API version, pinned to a fixed date per Sanity's versioning model.
# Safe to expose; not a credential.
SANITY_API_VERSION=2026-01-01

# Server-only. Never reference this with a PUBLIC_ prefix or import it into
# client-side code. Required for every build: this project's anonymous/public
# dataset access does not return custom document types (verified directly
# against the API), so src/lib/sanity.ts always reads with this token rather
# than depending on dataset visibility. Use a Viewer-permission token (read
# only) here — the build never needs to write.
SANITY_API_TOKEN=
