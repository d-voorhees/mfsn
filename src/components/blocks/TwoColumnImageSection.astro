---
import { urlFor } from '../../lib/sanity';
import { renderPortableText } from '../../lib/portableText';
import { resolveHref, isExternal } from '../../lib/link';
import { backgroundStyle } from '../../lib/sectionSettings';
import type { TwoColumnImageSectionBlock } from '../../types/sanity';

interface Props {
  block: TwoColumnImageSectionBlock;
}

const { block } = Astro.props;
const settings = block.settings ?? {};
---

<section
  class="focus-section"
  id={settings.anchorId || undefined}
  style={backgroundStyle(settings)}
>
  <div class="container">
    {block.heading && <h2 class="focus-heading text-start">{block.heading}</h2>}
    <div class="row g-5">
      {block.columns.map((column) => (
        <div class="col-lg-6 focus-col">
          <h3>{column.heading}</h3>
          <img src={urlFor(column.image).width(800).url()} alt={column.image.alt} class="focus-photo" />
          <Fragment set:html={renderPortableText(column.body)} />
          {column.noteText && <p class="partnership-note">{column.noteText}</p>}
          {column.actions && column.actions.length > 0 && (
            <div class="section-actions">
              {column.actions.map((action) => (
                <a
                  href={resolveHref(action.link)}
                  class={action.style === 'primary' ? 'btn-cta' : action.style === 'outlineGold' ? 'btn-cta-outline-gold' : 'btn-cta-outline'}
                  target={isExternal(action.link) ? '_blank' : undefined}
                  rel={isExternal(action.link) ? 'noopener' : undefined}
                >
                  {action.link.label}
                {isExternal(action.link) && <span class="visually-hidden"> (opens in a new tab)</span>}</a>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
