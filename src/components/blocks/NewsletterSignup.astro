---
import type { NewsletterSignupBlock } from '../../types/sanity';

interface Props {
  block: NewsletterSignupBlock;
}

const { block } = Astro.props;
---

<div>
  <h3>{block.heading}</h3>
  {block.description && <p>{block.description}</p>}
  {block.buttonUrl && (
    <div class="updates-signup-form">
      <a class="btn-signup" href={block.buttonUrl}>{block.buttonLabel || 'Sign Up'}</a>
    </div>
  )}
</div>
