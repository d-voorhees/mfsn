---
// Not a Sanity block type of its own — computed from the tags actually
// used across a page's resourceSpotlight blocks, so the jump-nav and each
// row's own tag pills can never drift out of sync the way two
// independently-authored lists could (see Phase 1's audit). PageBuilder
// renders this once, automatically, whenever a page contains at least one
// resourceSpotlight block; no route needs to know this exists.
import type { ResourceSpotlightBlock, CategoryData } from '../../types/sanity';

interface Props {
  blocks: ResourceSpotlightBlock[];
}

const { blocks } = Astro.props;

const seen = new Set<string>();
const tags: CategoryData[] = [];
for (const block of blocks) {
  for (const tag of block.tags) {
    if (!seen.has(tag._id)) {
      seen.add(tag._id);
      tags.push(tag);
    }
  }
}

// Each tag links to the first resourceSpotlight section that carries it.
const anchorFor = (tag: CategoryData): string | undefined => {
  const match = blocks.find((b) => b.tags.some((t) => t._id === tag._id));
  return match?.settings?.anchorId;
};
---

{tags.length > 0 && (
  <section class="intro-section">
    <div class="container">
      <h3 class="pt-5">Resource Topics</h3>
      <div class="master-tag-list">
        {tags.map((tag) => {
          const anchor = anchorFor(tag);
          return anchor ? (
            <a href={`#${anchor}`} class={`tag-pill tag-${tag.colorKey}`}>{tag.label}</a>
          ) : (
            <span class={`tag-pill tag-${tag.colorKey}`}>{tag.label}</span>
          );
        })}
      </div>
    </div>
  </section>
)}
