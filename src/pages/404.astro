---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" seo={{ metaTitle: 'Page Not Found | Manatee Food Security Network', metaDescription: 'This page could not be found. Return to the Manatee Food Security Network homepage or find free food and food assistance in Manatee County today.', noIndex: true }}>
  <section class="hero">
    <div class="hero-title-box">
      <h1>Page Not Found</h1>
    </div>
  </section>
  <section class="intro-section">
    <div class="container text-center">
      <p>
        The page you're looking for doesn't exist or may have moved. Try
        <a href="/">the homepage</a>, <a href="/search/">search</a>, or
        <a href="/find-food-now/">Find Food Now</a> if you're looking for food assistance today.
      </p>
    </div>
  </section>
</BaseLayout>
