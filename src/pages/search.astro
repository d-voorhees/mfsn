---
// Fallback for old /search/ links: opens the same search modal used by the
// nav icon (see SearchModal.astro and /site-search.js), using ?q= if given.
// The modal script is a static, non-bundled file on purpose: bundling it
// through Vite wraps the dynamic import of /pagefind/pagefind.js in a
// preload helper whose `__VITE_PRELOAD__` placeholder is never filled in,
// which threw on the live site and produced a false "dev only" message.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search" seo={{ metaTitle: 'Search | Manatee Food Security Network', metaDescription: 'Search the Manatee Food Security Network site for food assistance, partner organizations, resources, data, and meeting documents in Manatee County, Florida.', noIndex: true }}>
  <section class="hero">
    <div class="hero-title-box">
      <h1>Search</h1>
    </div>
  </section>
  <section class="intro-section">
    <div class="container">
      <button type="button" class="btn-cta" data-search-open>Search the site</button>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  window.addEventListener('DOMContentLoaded', function () {
    var q = new URLSearchParams(window.location.search).get('q');
    if (window.openSiteSearch) window.openSiteSearch(q || undefined);
  });
</script>
