---
// Real site search, replacing the source nav's dead `href="#"` search icon.
// Uses Pagefind (a build-time static search index) rather than a live
// backend, since the rest of the site is fully static — Pagefind indexes
// the built HTML during `npm run build` (see package.json's postbuild
// script) and ships a small WASM-backed client library the browser queries
// directly. This needs actual browser JS (there's no way to filter results
// as the visitor types using only HTML/CSS), but Pagefind itself is a
// purpose-built minimal library, not a UI framework, so a small inline
// script is the right amount of interactivity here — no client
// island/hydration needed.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search">
  <section class="hero">
    <div class="hero-title-box">
      <h1>Search</h1>
    </div>
  </section>
  <section class="intro-section">
    <div class="container">
      <form id="search-form" role="search" onsubmit="return false;">
        <label for="search-input" class="visually-hidden">Search the site</label>
        <input
          type="search"
          id="search-input"
          name="q"
          placeholder="Search the site&hellip;"
          class="form-control"
          autofocus
        />
      </form>
      <div id="search-results" aria-live="polite"></div>
    </div>
  </section>
</BaseLayout>

<script>
  type PagefindResult = { url: string; meta: { title?: string }; excerpt: string };
  type PagefindModule = {
    init: () => Promise<void>;
    search: (query: string) => Promise<{ results: Array<{ data: () => Promise<PagefindResult> }> }>;
    debouncedSearch: (
      query: string,
      options?: Record<string, unknown>,
      debounceMs?: number,
    ) => Promise<{ results: Array<{ data: () => Promise<PagefindResult> }> } | null>;
  };

  const input = document.getElementById('search-input') as HTMLInputElement;
  const resultsEl = document.getElementById('search-results') as HTMLElement;

  async function loadPagefind(): Promise<PagefindModule | null> {
    try {
      // Loaded through a variable, not a string literal, so neither
      // TypeScript nor Vite try to statically resolve this module — it only
      // exists in the built output, generated by the postbuild indexing
      // step, and isn't present at all during `astro dev`.
      const pagefindPath = '/pagefind/pagefind.js';
      return (await import(pagefindPath)) as PagefindModule;
    } catch {
      resultsEl.innerHTML = '<p>Search is only available on the built/deployed site, not in local dev.</p>';
      return null;
    }
  }

  let pagefind: PagefindModule | null = null;

  async function runSearch(query: string) {
    if (!query.trim()) {
      resultsEl.innerHTML = '';
      return;
    }
    pagefind ??= await loadPagefind();
    if (!pagefind) return;

    const search = await pagefind.debouncedSearch(query);
    if (!search) return; // superseded by a newer keystroke's search

    if (search.results.length === 0) {
      resultsEl.innerHTML = '<p>No results found.</p>';
      return;
    }

    const items = await Promise.all(search.results.map((r) => r.data()));
    resultsEl.innerHTML = items
      .map(
        (item) => `
          <div class="resource-row">
            <div class="resource-content">
              <h2><a href="${item.url}">${item.meta.title ?? item.url}</a></h2>
              <p>${item.excerpt}</p>
            </div>
          </div>
        `,
      )
      .join('');
  }

  input.addEventListener('input', () => runSearch(input.value));

  const params = new URLSearchParams(window.location.search);
  const initialQuery = params.get('q');
  if (initialQuery) {
    input.value = initialQuery;
    runSearch(initialQuery);
  }
</script>
